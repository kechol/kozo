{
  "name": "kozo-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "testing"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/dashboard",
    "check": "biome check .",
    "format": "biome format --write .",
    "compile": "bun run scripts/compile.ts",
    "version-packages": "changeset version && bun install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
